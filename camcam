#!/usr/bin/env bash
set -Eeuo pipefail

USER_NAME="${SUDO_USER:-${USER:-$(id -un)}}"
SUDO_FILE="/etc/sudoers.d/99_${USER_NAME}"
DOTFILES_REPO="https://github.com/genarovvv/dotfiles-c"
Z1_REPO="https://github.com/z1rov/z1"
SELF_TARGET="/usr/bin/camcam"
DOTDIR="$HOME/dotfiles-c"
BIN_SRC_DIR="$HOME/.config/bin"
PINKS=("205" "211" "213" "219" "225" "198" "165" "200")
LOGFILE="/tmp/camcam-install-$(date +%s).log"
ERROR_LOG="/tmp/camcam-error-$(date +%s).log"
touch "$LOGFILE" 2>/dev/null || LOGFILE="/dev/null"
touch "$ERROR_LOG" 2>/dev/null || ERROR_LOG="/dev/null"
ERROR_COUNT=0

APT_PKGS=(
  xorg xinit bspwm sxhkd polybar picom kitty rofi feh scrot
  eza bat xclip lxappearance zsh git curl fastfetch fonts-powerline
  thunar gvfs pipewire pipewire-pulse wireplumber papirus-icon-theme
  dunst flameshot gnome-themes-extra nano tree fonts-jetbrains-mono
  openvpn unzip zip htop jq brightnessctl pamixer neovim tmux
)

ART=(
'   ★   ██████╗ █████╗ ███╗   ███╗ ██████╗ █████╗ ███╗   ███╗   ★   '
'      ██╔════╝██╔══██╗████╗ ████║██╔════╝██╔══██╗████╗ ████║       '
'      ██║     ███████║██╔████╔██║██║     ███████║██╔████╔██║       '
'      ██║     ██╔══██║██║╚██╔╝██║██║     ██╔══██║██║╚██╔╝██║       '
'      ╚██████╗██║  ██║██║ ╚═╝ ██║╚██████╗██║  ██║██║ ╚═╝ ██║       '
'   ★   ╚═════╝╚═╝  ╚═╝╚═╝     ╚═╝ ╚═════╝╚═╝  ╚═╝╚═╝     ╚═╝   ★   '
)

_supports_color() {
  [[ -t 1 ]] || return 1
  command -v tput &>/dev/null || return 1
  local n
  n="$(tput colors 2>/dev/null || echo 0)"
  [[ "$n" -ge 8 ]]
}

if _supports_color; then
  COLOR_ENABLED=1
  REDRAW_ENABLED=1
  CLR_OK="\033[38;5;213m"
  CLR_ERR="\033[38;5;198m"
  CLR_INFO="\033[38;5;219m"
  CLR_WARN="\033[38;5;225m"
  CLR_META="\033[38;5;205m"
  CLR_ACCENT="\033[38;5;211m"
  CLR_DIM="\033[2m"
  CLR_BOLD="\033[1m"
  CLR_RESET="\033[0m"
else
  COLOR_ENABLED=0
  REDRAW_ENABLED=0
  CLR_OK=""
  CLR_ERR=""
  CLR_INFO=""
  CLR_WARN=""
  CLR_META=""
  CLR_ACCENT=""
  CLR_DIM=""
  CLR_BOLD=""
  CLR_RESET=""
fi

_ok()    { echo -e "  ${CLR_OK}[+]${CLR_RESET} $*"; }
_err() {
  echo -e "  ${CLR_ERR}[x]${CLR_RESET} $*"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$ERROR_LOG"
  ERROR_COUNT=$((ERROR_COUNT + 1))
}
_info()  { echo -e "  ${CLR_INFO}[*]${CLR_RESET} $*"; }
_warn()  { echo -e "  ${CLR_WARN}[~]${CLR_RESET} $*"; }
_dim()   { echo -e "  ${CLR_DIM}$*${CLR_RESET}"; }
_bold()  { echo -e "  ${CLR_BOLD}$*${CLR_RESET}"; }
_blank() { echo; }
_divider() { echo -e "  ${CLR_DIM}$(printf '=%.0s' {1..40})${CLR_RESET}"; }

_typewriter() {
  local text="$1" color="$2" delay="${3:-0.06}"
  local ch
  for ch in $(echo "$text" | grep -o .); do
    if [[ "$COLOR_ENABLED" -eq 1 ]]; then
      printf "%b%s%b" "$color" "$ch" "$CLR_RESET"
    else
      printf "%s" "$ch"
    fi
    sleep "$delay"
  done
  echo
}

_print_art() {
  local i=0 line color
  for line in "${ART[@]}"; do
    if [[ "$COLOR_ENABLED" -eq 1 ]]; then
      color="${PINKS[$((i % ${#PINKS[@]}))]}"
      printf "  \033[38;5;%sm%s\033[0m\n" "$color" "$line"
    else
      echo "  $line"
    fi
    i=$((i + 1))
  done
}

_banner() {
  clear
  _blank
  _print_art
  _blank
  echo -e "  ${CLR_META}[Meta]${CLR_RESET} camcam - built by gen"
  echo -e "  ${CLR_META}[Meta]${CLR_RESET} ${CLR_DIM}${DOTFILES_REPO}${CLR_RESET}"
  _blank
  if [[ "$REDRAW_ENABLED" -eq 1 ]]; then
    tput sc
  fi
}

_redraw() {
  if [[ "$REDRAW_ENABLED" -eq 1 ]]; then
    tput rc
    tput ed
  fi
}

_usage() {
  _banner
  echo -e "  ${CLR_INFO}[Info]${CLR_RESET} Usage: camcam <command>"
  _blank
  echo -e "  \033[38;5;211m[setup       ]\033[0m${CLR_DIM}::${CLR_RESET} full install: bspwm, docker, zsh, dotfiles-c, pink theme"
  echo -e "  \033[38;5;211m[vmware      ]\033[0m${CLR_DIM}::${CLR_RESET} configure open-vm-tools if running in VMware"
  echo -e "  \033[38;5;211m[bloodhound  ]\033[0m${CLR_DIM}::${CLR_RESET} deploy BloodHound CE via docker compose"
  echo -e "  \033[38;5;211m[ssh         ]\033[0m${CLR_DIM}::${CLR_RESET} generate ssh keys"
  echo -e "  \033[38;5;211m[z1          ]\033[0m${CLR_DIM}::${CLR_RESET} clone and install z1"
  echo -e "  \033[38;5;219m[diagnose    ]\033[0m${CLR_DIM}::${CLR_RESET} check binaries, configs and logs"
  echo -e "  \033[38;5;219m[help        ]\033[0m${CLR_DIM}::${CLR_RESET} show this help"
  _blank
  _divider
  _blank
}

_require_not_root() {
  if [[ $EUID -eq 0 ]]; then
    _err "Do not run this as root"
    exit 1
  fi
}

_confirm() {
  local prompt="$1" ans
  read -rp "  $prompt (Y/n): " ans
  ans=${ans,,}
  if [[ -n "$ans" && "$ans" != "y" && "$ans" != "yes" ]]; then
    return 1
  fi
  return 0
}

_setup_sudo() {
  if ! sudo -v; then
    _redraw
    _err "sudo authentication failed"
    exit 1
  fi

  sudo sh -c "echo '$USER_NAME ALL=(ALL) NOPASSWD: ALL' > '$SUDO_FILE'" &>>"$LOGFILE"
  sudo chmod 440 "$SUDO_FILE" &>>"$LOGFILE"

  if ! sudo visudo -cf "$SUDO_FILE" &>>"$LOGFILE"; then
    sudo rm -f "$SUDO_FILE"
    _redraw
    _err "invalid sudoers file, reverted"
    exit 1
  fi

  _redraw
  _ok "sudo NOPASSWD configured"
}

_self_install() {
  local src
  src="$(readlink -f "$0")"

  if [[ "$src" == "$SELF_TARGET" ]]; then
    _ok "camcam already available globally"
    return
  fi

  if sudo cp "$src" "$SELF_TARGET" &>>"$LOGFILE" && sudo chmod +x "$SELF_TARGET"; then
    _ok "camcam deployed, now use it from anywhere as: camcam"
  else
    _err "failed to deploy camcam to $SELF_TARGET"
  fi
}

_apt_update() {
  sudo apt-get update -y &>>"$LOGFILE" && _ok "apt updated" || _err "apt update failed"
}

_install_apt_quiet() {
  local pkg
  for pkg in "$@"; do
    if dpkg -s "$pkg" &>/dev/null; then
      continue
    fi
    sudo apt-get install -y "$pkg" &>>"$LOGFILE" || echo "$pkg"
  done
}

_write_xinitrc() {
  {
    echo "[[ -f ~/.Xresources ]] && xrdb -merge ~/.Xresources"
    echo "exec bspwm"
  } > "$HOME/.xinitrc"
}

_setup_theme() {
  local gtk_dir="$HOME/.config/gtk-3.0"
  mkdir -p "$gtk_dir"

  cat > "$gtk_dir/settings.ini" <<-EOF
	[Settings]
	gtk-theme-name=Adwaita
	gtk-icon-theme-name=Papirus-Dark
	gtk-application-prefer-dark-theme=1
	EOF

  if command -v papirus-folders &>/dev/null; then
    papirus-folders -C pink --theme Papirus-Dark &>>"$LOGFILE" && \
      _ok "Papirus folders set to pink" || \
      _err "papirus-folders failed to set pink folders"
  else
    _warn "papirus-folders not installed, skipping folder color"
  fi

  _ok "base theme configured (Papirus-Dark + pink accents)"
}

_setup_bspwm() {
  local failed_apt

  failed_apt="$(_install_apt_quiet "${APT_PKGS[@]}")"

  if [[ ! -f "$HOME/.xinitrc" ]]; then
    _write_xinitrc
  fi

  _setup_theme

  _redraw
  if [[ -z "$failed_apt" ]]; then
    _ok "packages installed"
  else
    _err "packages failed: $(echo "$failed_apt" | tr '\n' ' ')"
  fi
}

_setup_docker() {
  if command -v docker &>/dev/null; then
    _ok "docker already installed"
  else
    if sudo apt-get install -y docker.io docker-compose-v2 &>>"$LOGFILE" || \
       sudo apt-get install -y docker.io docker-compose &>>"$LOGFILE"; then
      _ok "docker installed"
    else
      _err "docker install failed"
      return
    fi
  fi

  sudo systemctl enable --now docker &>>"$LOGFILE" && _ok "docker service enabled" || _err "failed to enable docker service"

  if ! getent group docker | grep -q "\b${USER_NAME}\b"; then
    if sudo usermod -aG docker "$USER_NAME"; then
      _ok "$USER_NAME added to docker group"
    else
      _err "failed to add $USER_NAME to docker group"
    fi
  else
    _ok "$USER_NAME already in docker group"
  fi
}

_install_bloodhound() {
  local dir="$HOME/.config/bloodhound-ce"
  mkdir -p "$dir"

  pushd "$dir" &>/dev/null || { _err "failed to create $dir"; return; }

  if [[ -f docker-compose.yml ]]; then
    _ok "BloodHound docker-compose.yml already present"
  else
    if curl -fsSL https://ghst.ly/getbhce -o docker-compose.yml &>>"$LOGFILE"; then
      _ok "BloodHound docker-compose.yml downloaded"
    else
      _err "failed to download BloodHound docker-compose"
      popd &>/dev/null || true
      return
    fi
  fi

  if ! command -v docker &>/dev/null; then
    _err "docker not available, run: camcam setup first"
    popd &>/dev/null || true
    return
  fi

  local admin_pass
  admin_pass="Cam$(head -c 6 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 8)!"

  if ! grep -q "bhe_default_admin_password" docker-compose.yml; then
    sed -i "/Add additional environment variables you wish to use here/a\\      - bhe_default_admin_principal_name=admin\\n      - bhe_default_admin_password=\${BH_ADMIN_PASSWORD:-${admin_pass}}" docker-compose.yml
    _ok "admin password injected into docker-compose.yml"
  fi

  if BH_ADMIN_PASSWORD="$admin_pass" bhe_recreate_default_admin=true docker compose up -d &>>"$LOGFILE"; then
    local tries=0 reachable=0
    while [[ $tries -lt 15 ]]; do
      if curl -fsS -o /dev/null "http://localhost:8080/ui/login" 2>>"$LOGFILE"; then
        reachable=1
        break
      fi
      sleep 2
      tries=$((tries + 1))
    done

    if [[ $reachable -eq 1 ]]; then
      _ok "BloodHound CE is reachable on http://localhost:8080/ui/login"
      _ok "login -> admin | password -> $admin_pass"
    else
      _warn "container started but did not respond in time, check manually"
    fi

    if docker compose down &>>"$LOGFILE"; then
      _ok "BloodHound containers stopped"
      _blank
      _info "to bring it back up:"
      _bold "docker compose -f $dir/docker-compose.yml up -d"
    else
      _err "failed to stop the containers"
    fi
  else
      _err "BloodHound docker compose failed (log: $LOGFILE)"
  fi

  popd &>/dev/null || true
}

_setup_zsh() {
  local failed
  failed="$(_install_apt_quiet zsh)"

  if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
    CHSH=no RUNZSH=no KEEP_ZSHRC=yes sh -c \
      "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" \
      "" --unattended &>>"$LOGFILE"
  fi

  local zsh_custom="$HOME/.oh-my-zsh/custom"
  git clone https://github.com/zsh-users/zsh-autosuggestions \
    "$zsh_custom/plugins/zsh-autosuggestions" &>>"$LOGFILE" || true
  git clone https://github.com/zsh-users/zsh-syntax-highlighting \
    "$zsh_custom/plugins/zsh-syntax-highlighting" &>>"$LOGFILE" || true
  git clone --depth=1 https://github.com/romkatv/powerlevel10k.git \
    "$HOME/.powerlevel10k" &>>"$LOGFILE" || true

  sudo chsh -s /bin/zsh "$USER_NAME" &>>"$LOGFILE" || true

  _redraw
  if [[ -d "$HOME/.oh-my-zsh" && -z "$failed" ]]; then
    _ok "zsh + oh-my-zsh + powerlevel10k ready"
  else
    _err "zsh setup failed"
  fi
}

_setup_dotfiles() {
  if [[ -d "$DOTDIR/.git" ]]; then
    git -C "$DOTDIR" pull &>>"$LOGFILE" && _ok "dotfiles-c updated" || _err "failed to update dotfiles-c"
  else
    if git clone "$DOTFILES_REPO" "$DOTDIR" &>>"$LOGFILE"; then
      _ok "dotfiles-c cloned"
    else
      _err "dotfiles-c clone failed"
      return
    fi
  fi

  mkdir -p "$HOME/.config"

  if [[ -d "$DOTDIR/config" ]]; then
    cp -rf "$DOTDIR/config/." "$HOME/.config/"
    _ok "config/ deployed"
  fi
  if [[ -f "$DOTDIR/home/.zshrc" ]]; then
    cp "$DOTDIR/home/.zshrc" "$HOME/"
    _ok ".zshrc deployed"
  fi
  if [[ -f "$DOTDIR/home/.p10k.zsh" ]]; then
    cp "$DOTDIR/home/.p10k.zsh" "$HOME/"
    _ok ".p10k.zsh deployed"
  fi

  if [[ -f "$HOME/.config/bspwm/bspwmrc" ]]; then
    chmod +x "$HOME/.config/bspwm/bspwmrc"
  fi
  if [[ -f "$HOME/.config/sxhkd/sxhkdrc" ]]; then
    chmod +x "$HOME/.config/sxhkd/sxhkdrc"
  fi
  if [[ -d "$HOME/.config/bspwm/scripts" ]]; then
    find "$HOME/.config/bspwm/scripts" -type f -exec chmod 755 {} \;
  fi

  if [[ -d "$BIN_SRC_DIR" ]]; then
    while IFS= read -r -d '' binfile; do
      local bname
      bname="$(basename "$binfile")"
      if [[ "$bname" == .* || "$bname" == README* || "$bname" == LICENSE* ]]; then
        continue
      fi
      chmod +x "$binfile"
      if sudo ln -sf "$binfile" "/usr/bin/$bname" &>>"$LOGFILE"; then
        _ok "$bname available from anywhere"
      else
        _err "failed to link $bname in /usr/bin"
      fi
    done < <(find "$BIN_SRC_DIR" -maxdepth 1 -type f -print0)
  fi

  if [[ -d "$DOTDIR/fonts" ]]; then
    sudo mkdir -p /usr/local/share/fonts/camcam
    sudo cp -f "$DOTDIR/fonts/"* /usr/local/share/fonts/camcam/ &>>"$LOGFILE" || true
    fc-cache -f &>>"$LOGFILE" || true
    _ok "fonts installed"
  fi

  mkdir -p "$HOME/Documents" "$HOME/Downloads"
  _ok "dotfiles-c deployed"
}

_setup_vmware() {
  if ! systemd-detect-virt --quiet --vm 2>/dev/null | grep -q vmware && \
     ! grep -qi "vmware" /sys/class/dmi/id/sys_vendor 2>/dev/null; then
    _warn "not running inside VMware, skipping"
    return
  fi

  if sudo apt-get install -y open-vm-tools open-vm-tools-desktop &>>"$LOGFILE"; then
    _ok "open-vm-tools installed"
  else
    _err "open-vm-tools install failed"
    return
  fi

  sudo systemctl enable --now open-vm-tools.service &>>"$LOGFILE" || true
  _ok "open-vm-tools enabled"

  local bspwmrc="$HOME/.config/bspwm/bspwmrc"
  if [[ -f "$bspwmrc" ]]; then
    if ! grep -q "vmware-user" "$bspwmrc"; then
      {
        echo ""
        echo "pgrep vmware-user || vmware-user &"
      } >> "$bspwmrc"
      _ok "vmware-user added to bspwmrc"
    else
      _ok "vmware-user already in bspwmrc"
    fi
  else
    _err "bspwmrc not found, add 'pgrep vmware-user || vmware-user &' manually"
  fi
}

_generate_ssh_key() {
  local path="$1" type="$2" bits="$3" pass="$4" ssh_user="$5"

  if [[ -f "$path" ]]; then
    read -rp "  [!] $path already exists, overwrite? (y/N): " ow
    if [[ "${ow,,}" != "y" ]]; then
      return
    fi
    cp "$path" "$path.bak" 2>/dev/null || true
    cp "$path.pub" "$path.pub.bak" 2>/dev/null || true
    rm -f "$path" "$path.pub"
  fi

  if [[ "$type" == "rsa" ]]; then
    ssh-keygen -t rsa -b "$bits" -f "$path" -C "${ssh_user}@$(hostname)" -N "$pass" -q
  else
    ssh-keygen -t ed25519 -f "$path" -C "${ssh_user}@$(hostname)" -N "$pass" -q
  fi

  chmod 600 "$path"
  chmod 644 "$path.pub"
  _ok "$type key generated"
}

_setup_ssh() {
  _confirm "Generate SSH keys?" || return

  local default_user="$USER_NAME"
  _blank
  _dim "1) Basic   - no passphrase"
  _dim "2) Secure  - with passphrase (recommended)"
  read -rp "  Select option [1]: " mode
  if [[ "$mode" != "2" ]]; then
    mode=1
  fi

  read -rp "  SSH key label [${default_user}]: " ssh_user
  ssh_user="${ssh_user:-$default_user}"

  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"

  local pass_rsa="" pass_ed25519=""

  if [[ "$mode" == "2" ]]; then
    while true; do
      read -s -p "  RSA passphrase: " p1; echo
      read -s -p "  Confirm: " p2; echo
      if [[ "$p1" == "$p2" ]]; then
        pass_rsa="$p1"
        break
      fi
      _err "passphrases do not match"
    done

    read -s -p "  ED25519 passphrase (ENTER = reuse RSA): " q1; echo
    if [[ -z "$q1" ]]; then
      pass_ed25519="$pass_rsa"
    else
      while true; do
        read -s -p "  Confirm ED25519: " q2; echo
        if [[ "$q1" == "$q2" ]]; then
          pass_ed25519="$q1"
          break
        fi
        _err "passphrases do not match"
      done
    fi
  fi

  _generate_ssh_key "$HOME/.ssh/id_rsa"     "rsa"     4096 "$pass_rsa"     "$ssh_user"
  _generate_ssh_key "$HOME/.ssh/id_ed25519" "ed25519" ""   "$pass_ed25519" "$ssh_user"

  if [[ -f "$HOME/.ssh/id_rsa.pub" ]]; then
    _blank
    _dim "--- id_rsa.pub ---"
    cat "$HOME/.ssh/id_rsa.pub"
  fi

  if [[ -f "$HOME/.ssh/id_ed25519.pub" ]]; then
    _blank
    _dim "--- id_ed25519.pub ---"
    cat "$HOME/.ssh/id_ed25519.pub"
  fi
}

_install_z1() {
  local dir="/tmp/z1-$$"
  rm -rf "$dir"

  if git clone "$Z1_REPO" "$dir" &>>"$LOGFILE"; then
    _ok "z1 cloned"
  else
    _err "z1 clone failed"
    return
  fi

  pushd "$dir" &>/dev/null || { _err "failed to enter $dir"; return; }

  if make install &>>"$LOGFILE"; then
    _ok "z1 installed"
  else
    _err "z1 make install failed (log: $LOGFILE)"
  fi

  popd &>/dev/null || true
  rm -rf "$dir"
}

_check_binary() {
  local bin="$1"
  if command -v "$bin" &>/dev/null; then
    _ok "$bin found"
  else
    _err "$bin missing"
  fi
}

_diagnose() {
  _bold "Diagnostics"

  local bin
  for bin in bspwm sxhkd kitty picom polybar rofi feh thunar tmux nvim dunst fastfetch zsh docker openvpn flameshot; do
    _check_binary "$bin"
  done

  if [[ -f "$HOME/.xinitrc" ]] && grep -q "exec bspwm" "$HOME/.xinitrc"; then
    _ok ".xinitrc points to bspwm"
  else
    _err ".xinitrc missing or not launching bspwm"
  fi

  if [[ -x "$HOME/.config/bspwm/bspwmrc" ]]; then
    _ok "bspwmrc deployed and executable"
  else
    _err "bspwmrc missing or not executable, run: camcam setup"
  fi

  if [[ -d "$HOME/.oh-my-zsh" ]]; then
    _ok "oh-my-zsh installed"
  else
    _err "oh-my-zsh missing"
  fi

  if [[ -d "$HOME/.powerlevel10k" ]]; then
    _ok "powerlevel10k installed"
  else
    _err "powerlevel10k missing"
  fi

  if [[ -f "$HOME/.config/bloodhound-ce/docker-compose.yml" ]]; then
    _ok "BloodHound docker-compose present"
  else
    _err "BloodHound docker-compose missing, run: camcam bloodhound"
  fi

  if [[ -x "$SELF_TARGET" ]]; then
    _ok "camcam available globally"
  else
    _err "camcam not deployed globally, run: camcam setup"
  fi

  _blank
  if [[ "$ERROR_COUNT" -gt 0 ]]; then
    _warn "$ERROR_COUNT issue(s) found, details in $ERROR_LOG"
  else
    _ok "all good"
  fi
}

_ask_reboot() {
  _blank
  if _confirm "Reboot now?"; then
    _ok "rebooting..."
    sudo reboot
  else
    _info "reboot skipped, remember to reboot before relying on docker or the new shell"
  fi
}

_farewell() {
  _blank
  _typewriter "for cam, by gen" "$CLR_ACCENT" 0.05
  _blank
}

_install_full() {
  _setup_sudo
  _self_install
  _apt_update
  _setup_bspwm
  _setup_docker
  _setup_zsh
  _setup_dotfiles

  _blank
  if [[ "$ERROR_COUNT" -gt 0 ]]; then
    _warn "install finished with $ERROR_COUNT error(s), check $ERROR_LOG"
  else
    _ok "install finished"
  fi

  _farewell
  _ask_reboot
}

_main() {
  local cmd="${1:-}"
  case "$cmd" in
    setup)
      _require_not_root
      _banner
      _confirm "Continue with the install?" || exit 0
      _install_full
      ;;
    vmware)
      _require_not_root
      _banner
      _setup_sudo
      _setup_vmware
      _farewell
      ;;
    bloodhound)
      _require_not_root
      _banner
      _setup_sudo
      _install_bloodhound
      _farewell
      ;;
    ssh)
      _require_not_root
      _banner
      _setup_ssh
      _farewell
      ;;
    z1)
      _require_not_root
      _banner
      _setup_sudo
      _install_z1
      _farewell
      ;;
    diagnose)
      _banner
      _diagnose
      _blank
      _divider
      _blank
      ;;
    help|-h|--help|"")
      _usage
      ;;
    *)
      _err "Unknown command: $cmd"
      _usage
      exit 1
      ;;
  esac
}

_main "$@"
